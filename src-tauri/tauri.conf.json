{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Stream",
  "version": "0.1.0",
  "identifier": "app.nexusstream.desktop",
  "build": {
    "frontendDist": "../public",
    "beforeBuildCommand": "node scripts/prepare-bundle.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "resources": [
      "runtime/server.mjs",
      "runtime/app.env",
      "runtime/bin/*",
      "runtime/web/**/*"
    ]
  }
}
